# Riera (Catalan) - its own Supabase project, entirely separate from Darya's.
# Fill these from the new project's dashboard, then run:
#   ./scripts/bootstrap-lang.sh ca riera <project-ref>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Reuses Darya's AI providers; no separate account needed.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Web push needs its own pair per deployment:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
