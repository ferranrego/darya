# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local scratch: reference photos, never commit
/temp/

# Points at the active language's content; written by scripts/link-content.ts
content/active

# Raw corpora for scripts/build-frequency.ts (tens of MB, re-fetch with --download).
# The derived ranking in scripts/data/freq-*.tsv IS committed.
/scripts/data/corpus/

# Throwaway probes and generated diagnostics. ~38 of these accumulated at the
# repo root and were committed - four of them were the only thing failing
# `pnpm lint`. They are regenerable output, never inputs; keep them untracked
# so a stray probe cannot break the gate for everyone else.
*.log
/scratch/
/test-*.ts
/test-*.js
/test-*.cjs
/eslint-report.json
/*.html
