        {
          "id": "gl-55",
          "title": "Even though",
          "subtitle": "Concession with harchand",
          "grammarPoint": "concession",
          "grammarPointEn": "Concessive clauses with harchand (even though) and bā wujūd-e īn (despite this), granting a point before contrasting it.",
          "slides": [
            {
              "id": "gs-55-1",
              "title": "harchand … but",
              "body": "harchand means 'even though'. It opens a clause you concede, before a contrasting main clause, often with amā.",
              "examples": [
                { "dari": "هرچند مانده بود، کار کرد", "translit": "harchand mānda būd, kār kard", "en": "Even though he was tired, he worked.", "highlight": "هرچند" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-55-1", "type": "fillBlank", "dari": "___ مانده بود، کار کرد", "translit": "___ mānda būd, kār kard", "en": "Even though he was tired, he worked.", "answer": { "dari": "هرچند", "translit": "harchand" }, "distractors": [{ "dari": "چون", "translit": "chun" }, { "dari": "اگر", "translit": "agar" }] },
            { "id": "ge-55-2", "type": "chooseTranslation", "direction": "toEn", "dari": "هرچند باران بود، رفتیم", "translit": "harchand bārān būd, raftēm", "en": "Even though it was raining, we went.", "distractorsEn": ["Because it was raining, we went.", "If it rains, we go."] },
            { "id": "ge-55-3", "type": "buildSentence", "en": "Even though he was sick, he came.", "words": [{ "dari": "هرچند", "translit": "harchand" }, { "dari": "مریض", "translit": "marīz" }, { "dari": "بود", "translit": "būd" }, { "dari": "آمد", "translit": "āmad" }], "translit": "harchand marīz būd, āmad", "extraWords": [{ "dari": "چون", "translit": "chun" }] },
            { "id": "ge-55-4", "type": "chooseTranslation", "direction": "toDari", "dari": "هرچند کلان است، ارزان است", "translit": "harchand kalān ast, arzān ast", "en": "Even though it is big, it is cheap.", "distractorsDari": [{ "dari": "چون کلان است، ارزان است", "translit": "chun kalān ast, arzān ast" }, { "dari": "کلان است اما گران است", "translit": "kalān ast amā gerān ast" }] },
            { "id": "ge-55-5", "type": "matchPairs", "prompt": "Match the linkers", "pairs": [{ "dari": "هرچند", "translit": "harchand", "en": "even though" }, { "dari": "چون", "translit": "chun", "en": "because" }, { "dari": "اما", "translit": "amā", "en": "but" }, { "dari": "اگر", "translit": "agar", "en": "if" }] },
            { "id": "ge-55-6", "type": "spotError", "dari": "چون مانده بود، اما کار کرد", "translit": "chun mānda būd, amā kār kard", "en": "Even though he was tired, he worked.", "errorWord": { "dari": "چون", "translit": "chun" }, "correction": { "dari": "هرچند", "translit": "harchand" }, "hint": "A conceded point uses harchand, not chun (because)." }
          ]
