            { "id": "ge-54-2", "type": "chooseTranslation", "direction": "toEn", "dari": "آن کتابی که خواندم، مقبول بود", "translit": "ān ketābē ke khāndam, maqbūl būd", "en": "That book which I read was beautiful.", "distractorsEn": ["A book I read was beautiful.", "That beautiful book, I read it."] },
            { "id": "ge-54-3", "type": "buildSentence", "en": "The city that I saw was big.", "words": [{ "dari": "آن", "translit": "ān" }, { "dari": "شهری", "translit": "shahrē" }, { "dari": "که", "translit": "ke" }, { "dari": "دیدم", "translit": "dīdam" }, { "dari": "کلان", "translit": "kalān" }, { "dari": "بود", "translit": "būd" }], "translit": "ān shahrē ke dīdam, kalān būd", "extraWords": [{ "dari": "را", "translit": "rā" }] },
