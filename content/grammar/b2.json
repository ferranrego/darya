        {
          "id": "gl-56",
          "title": "Until, as soon as",
          "subtitle": "The many senses of tā",
          "grammarPoint": "ta-constructions",
          "grammarPointEn": "The word tā across senses: 'until' (tā ke), 'as soon as', and 'so that' (purpose); reading which meaning from context.",
          "slides": [
            {
              "id": "gs-56-1",
              "title": "One word, three jobs",
              "body": "tā can mean 'in order to' (with the subjunctive), 'until' (with a limit), or 'as soon as'. The verb form and context tell you which.",
              "examples": [
                { "dari": "صبر کن تا بیایم", "translit": "sabr kun tā biāyam", "en": "Wait until I come.", "highlight": "تا" },
                { "dari": "تا او را دیدم، خوش شدم", "translit": "tā ō rā dīdam, khush shudam", "en": "As soon as I saw him, I was happy.", "highlight": "تا" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-56-1", "type": "chooseTranslation", "direction": "toEn", "dari": "صبر کن تا بیایم", "translit": "sabr kun tā biāyam", "en": "Wait until I come.", "distractorsEn": ["Wait because I am coming.", "Don't wait, I will come."] },
            { "id": "ge-56-2", "type": "chooseTranslation", "direction": "toEn", "dari": "تا او را دیدم، خوش شدم", "translit": "tā ō rā dīdam, khush shudam", "en": "As soon as I saw him, I was happy.", "distractorsEn": ["Until I saw him, I was happy.", "I saw him so that I'd be happy."] },
            { "id": "ge-56-3", "type": "fillBlank", "dari": "صبر کن ___ بیایم", "translit": "sabr kun ___ biāyam", "en": "Wait until I come.", "answer": { "dari": "تا", "translit": "tā" }, "distractors": [{ "dari": "که", "translit": "ke" }, { "dari": "چون", "translit": "chun" }] },
            { "id": "ge-56-4", "type": "buildSentence", "en": "As soon as he came, we left.", "words": [{ "dari": "تا", "translit": "tā" }, { "dari": "آمد", "translit": "āmad" }, { "dari": "ما", "translit": "mā" }, { "dari": "رفتیم", "translit": "raftēm" }], "translit": "tā āmad, mā raftēm", "extraWords": [{ "dari": "اگر", "translit": "agar" }] },
            { "id": "ge-56-5", "type": "chooseTranslation", "direction": "toDari", "dari": "صبر کن تا نان بخورم", "translit": "sabr kun tā nān bukhuram", "en": "Wait so that I can eat.", "distractorsDari": [{ "dari": "صبر کن چون نان می‌خورم", "translit": "sabr kun chun nān mēkhuram" }, { "dari": "نان خوردم و صبر کردم", "translit": "nān khurdam wa sabr kardam" }] },
            { "id": "ge-56-6", "type": "matchPairs", "prompt": "Match the sense of tā", "pairs": [{ "dari": "تا بیایم", "translit": "tā biāyam", "en": "until / so that I come" }, { "dari": "تا دیدم", "translit": "tā dīdam", "en": "as soon as I saw" }, { "dari": "وقتی که", "translit": "waqtē ke", "en": "when" }, { "dari": "اگر", "translit": "agar", "en": "if" }] }
          ]
        },
        {
          "id": "gl-57",
          "title": "While and the moment that",
          "subtitle": "Simultaneous actions",
          "grammarPoint": "simultaneity",
          "grammarPointEn": "Simultaneous actions with dar hālē ke (while) and hamīn ke (the moment that), joining two overlapping events.",
          "slides": [
            {
              "id": "gs-57-1",
              "title": "At the same time",
              "body": "dar hālē ke means 'while' — two things at once. hamīn ke means 'the moment that' — one triggers the other.",
              "examples": [
                { "dari": "در حالی که نان می‌خوردم، او آمد", "translit": "dar hālē ke nān mēkhurdam, ō āmad", "en": "While I was eating, he came.", "highlight": "در حالی که" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-57-1", "type": "chooseTranslation", "direction": "toEn", "dari": "در حالی که نان می‌خوردم، او آمد", "translit": "dar hālē ke nān mēkhurdam, ō āmad", "en": "While I was eating, he came.", "distractorsEn": ["After I ate, he came.", "Because I was eating, he came."] },
            { "id": "ge-57-2", "type": "fillBlank", "dari": "___ که او را دیدم، خوش شدم", "translit": "___ ke ō rā dīdam, khush shudam", "en": "The moment I saw him, I was happy.", "answer": { "dari": "همین", "translit": "hamīn" }, "distractors": [{ "dari": "اگر", "translit": "agar" }, { "dari": "چون", "translit": "chun" }] },
            { "id": "ge-57-3", "type": "buildSentence", "en": "While I was reading, he slept.", "words": [{ "dari": "در حالی که", "translit": "dar hālē ke" }, { "dari": "می‌خواندم", "translit": "mēkhāndam" }, { "dari": "او", "translit": "ō" }, { "dari": "خوابید", "translit": "khābīd" }], "translit": "dar hālē ke mēkhāndam, ō khābīd", "extraWords": [{ "dari": "خواندم", "translit": "khāndam" }] },
            { "id": "ge-57-4", "type": "chooseTranslation", "direction": "toDari", "dari": "همین که آمد، رفتیم", "translit": "hamīn ke āmad, raftēm", "en": "The moment he came, we left.", "distractorsDari": [{ "dari": "وقتی که آمد، رفتیم", "translit": "waqtē ke āmad, raftēm" }, { "dari": "چون آمد، رفتیم", "translit": "chun āmad, raftēm" }] },
            { "id": "ge-57-5", "type": "matchPairs", "prompt": "Match the time linkers", "pairs": [{ "dari": "در حالی که", "translit": "dar hālē ke", "en": "while" }, { "dari": "همین که", "translit": "hamīn ke", "en": "the moment that" }, { "dari": "تا", "translit": "tā", "en": "as soon as" }, { "dari": "بعد از آن", "translit": "bād az ān", "en": "after that" }] },
            { "id": "ge-57-6", "type": "spotError", "dari": "چون نان می‌خوردم، او آمد", "translit": "chun nān mēkhurdam, ō āmad", "en": "While I was eating, he came.", "errorWord": { "dari": "چون", "translit": "chun" }, "correction": { "dari": "در حالی که", "translit": "dar hālē ke" }, "hint": "Two actions at once use 'while', not 'because'." }
          ]
        }
      ]
