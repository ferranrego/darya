  "blocks": [
    {
      "id": "gb-16",
      "title": "Unreal Worlds",
      "subtitle": "What might have been",
      "lessons": [
        {
          "id": "gl-48",
          "title": "If I had known",
          "subtitle": "Counterfactual conditionals",
          "grammarPoint": "counterfactual-conditionals",
          "grammarPointEn": "Counterfactual (unreal) conditionals: agar + mē- past in the if-clause and mē- past in the result: agar mēdānistam, namēraftam (if I had known, I wouldn't have gone).",
          "slides": [
            {
              "id": "gs-48-1",
              "title": "Unreal uses mē- past",
              "body": "For something contrary to fact — that didn't actually happen — both clauses use the mē- past. 'If I had known (but I didn't), I wouldn't have gone.'",
              "examples": [
                { "dari": "اگر می‌دانستم، نمی‌رفتم", "translit": "agar mēdānistam, namēraftam", "en": "If I had known, I wouldn't have gone.", "highlight": "می‌دانستم" }
              ]
            },
            {
              "id": "gs-48-2",
              "title": "Real vs unreal",
              "body": "Compare: agar burawi (if you go — still possible) with agar mērafti (if you had gone — but you didn't). The mē- past signals 'unreal'.",
              "examples": [
                { "dari": "اگر وقت می‌داشتم، می‌آمدم", "translit": "agar waqt mēdāshtam, mēāmadam", "en": "If I had had time, I would have come.", "highlight": "می‌آمدم" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-48-1", "type": "fillBlank", "dari": "اگر ___، نمی‌رفتم", "translit": "agar ___, namēraftam", "en": "If I had known, I wouldn't have gone.", "answer": { "dari": "می‌دانستم", "translit": "mēdānistam" }, "distractors": [{ "dari": "بدانم", "translit": "bidānam" }, { "dari": "دانستم", "translit": "dānistam" }] },
            { "id": "ge-48-2", "type": "chooseTranslation", "direction": "toEn", "dari": "اگر وقت می‌داشتم، می‌آمدم", "translit": "agar waqt mēdāshtam, mēāmadam", "en": "If I had had time, I would have come.", "distractorsEn": ["If I have time, I'll come.", "I had time and I came."] },
            { "id": "ge-48-3", "type": "spotError", "dari": "اگر می‌دانستم، نرفتم", "translit": "agar mēdānistam, naraftam", "en": "If I had known, I wouldn't have gone.", "errorWord": { "dari": "نرفتم", "translit": "naraftam" }, "correction": { "dari": "نمی‌رفتم", "translit": "namēraftam" }, "hint": "The unreal result also takes the mē- past." },
            { "id": "ge-48-4", "type": "buildSentence", "en": "If you had come, you would have seen him.", "words": [{ "dari": "اگر", "translit": "agar" }, { "dari": "می‌آمدی", "translit": "mēāmadi" }, { "dari": "او را", "translit": "ō rā" }, { "dari": "می‌دیدی", "translit": "mēdīdi" }], "translit": "agar mēāmadi, ō rā mēdīdi", "extraWords": [{ "dari": "بیایی", "translit": "biāyi" }] },
            { "id": "ge-48-5", "type": "chooseTranslation", "direction": "toDari", "dari": "اگر پول می‌داشتم، کتاب می‌خریدم", "translit": "agar pūl mēdāshtam, ketāb mēkharīdam", "en": "If I had had money, I would have bought a book.", "distractorsDari": [{ "dari": "اگر پول داشته باشم، کتاب می‌خرم", "translit": "agar pūl dāshta bāsham, ketāb mēkharam" }, { "dari": "پول داشتم و کتاب خریدم", "translit": "pūl dāshtam wa ketāb kharīdam" }] },
            { "id": "ge-48-6", "type": "fillBlank", "dari": "اگر او می‌آمد، ما ___", "translit": "agar ō mēāmad, mā ___", "en": "If he had come, we would have been happy.", "answer": { "dari": "خوش می‌شدیم", "translit": "khush mēshudēm" }, "distractors": [{ "dari": "خوش شدیم", "translit": "khush shudēm" }, { "dari": "خوش می‌شویم", "translit": "khush mēshawēm" }] }
          ]
        },
        {
          "id": "gl-49",
          "title": "If only he came",
          "subtitle": "Wishes and regrets with kāsh",
          "grammarPoint": "wishes-kash",
          "grammarPointEn": "Wishes with kāsh (if only) + mē- past for an unfulfilled present/future wish: kāsh mēāmad (if only he would come / had come).",
          "slides": [
            {
              "id": "gs-49-1",
              "title": "kāsh + mē- past",
              "body": "kāsh means 'if only'. For a wish that isn't reality, follow it with the mē- past: kāsh mēāmad — 'if only he would come'.",
              "examples": [
                { "dari": "کاش اینجا می‌بودی", "translit": "kāsh īnjā mēbūdi", "en": "If only you were here.", "highlight": "کاش" },
                { "dari": "کاش او می‌آمد", "translit": "kāsh ō mēāmad", "en": "If only he would come.", "highlight": "می‌آمد" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-49-1", "type": "fillBlank", "dari": "___ او می‌آمد", "translit": "___ ō mēāmad", "en": "If only he would come.", "answer": { "dari": "کاش", "translit": "kāsh" }, "distractors": [{ "dari": "شاید", "translit": "shāyad" }, { "dari": "اگر", "translit": "agar" }] },
            { "id": "ge-49-2", "type": "chooseTranslation", "direction": "toEn", "dari": "کاش اینجا می‌بودی", "translit": "kāsh īnjā mēbūdi", "en": "If only you were here.", "distractorsEn": ["Maybe you are here.", "You were here."] },
            { "id": "ge-49-3", "type": "spotError", "dari": "کاش او آمد", "translit": "kāsh ō āmad", "en": "If only he would come.", "errorWord": { "dari": "آمد", "translit": "āmad" }, "correction": { "dari": "می‌آمد", "translit": "mēāmad" }, "hint": "A wish that isn't real takes the mē- past." },
            { "id": "ge-49-4", "type": "buildSentence", "en": "If only I had more time.", "words": [{ "dari": "کاش", "translit": "kāsh" }, { "dari": "وقت", "translit": "waqt-e" }, { "dari": "زیاد", "translit": "zyād" }, { "dari": "می‌داشتم", "translit": "mēdāshtam" }], "translit": "kāsh waqt-e zyād mēdāshtam", "extraWords": [{ "dari": "دارم", "translit": "dāram" }] },
            { "id": "ge-49-5", "type": "chooseTranslation", "direction": "toDari", "dari": "کاش می‌توانستم بیایم", "translit": "kāsh mētawānistam biāyam", "en": "If only I could come.", "distractorsDari": [{ "dari": "می‌توانم بیایم", "translit": "mētawānam biāyam" }, { "dari": "کاش آمدم", "translit": "kāsh āmadam" }] },
            { "id": "ge-49-6", "type": "matchPairs", "prompt": "Match the modal moods", "pairs": [{ "dari": "کاش می‌آمد", "translit": "kāsh mēāmad", "en": "if only he'd come" }, { "dari": "شاید بیاید", "translit": "shāyad biāyad", "en": "maybe he'll come" }, { "dari": "باید بیاید", "translit": "bāyad biāyad", "en": "he must come" }, { "dari": "اگر بیاید", "translit": "agar biāyad", "en": "if he comes" }] }
          ]
        },
        {
          "id": "gl-50",
          "title": "He may have gone",
          "subtitle": "The past subjunctive",
          "grammarPoint": "past-subjunctive",
          "grammarPointEn": "Past subjunctive: past participle + bāsham/bāshi/bāshad… (rafta bāsham), used after shāyad, mumkin, and doubt about a past event.",
          "slides": [
            {
              "id": "gs-50-1",
              "title": "participle + bāshad",
              "body": "To talk about a past action you're unsure of, use the participle + the subjunctive of budan (bāshad): shāyad rafta bāshad — 'maybe he has gone'.",
              "table": [["man", "rafta bāsham"], ["tu", "rafta bāshi"], ["ō", "rafta bāshad"], ["mā", "rafta bāshēm"], ["shumā", "rafta bāshēd"], ["ānhā", "rafta bāshand"]],
              "examples": [
                { "dari": "شاید او رفته باشد", "translit": "shāyad ō rafta bāshad", "en": "Maybe he has gone.", "highlight": "رفته باشد" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-50-1", "type": "fillBlank", "dari": "شاید او ___", "translit": "shāyad ō ___", "en": "Maybe he has gone.", "answer": { "dari": "رفته باشد", "translit": "rafta bāshad" }, "distractors": [{ "dari": "رفت", "translit": "raft" }, { "dari": "می‌رود", "translit": "mērawad" }] },
            { "id": "ge-50-2", "type": "chooseTranslation", "direction": "toEn", "dari": "ممکن است که نان خورده باشد", "translit": "mumken ast ke nān khurda bāshad", "en": "He may have eaten bread.", "distractorsEn": ["He is eating bread.", "He must eat bread."] },
            { "id": "ge-50-3", "type": "spotError", "dari": "شاید او رفته است", "translit": "shāyad ō rafta ast", "en": "Maybe he has gone.", "errorWord": { "dari": "است", "translit": "ast" }, "correction": { "dari": "باشد", "translit": "bāshad" }, "hint": "Doubt about the past takes bāshad, not ast." },
            { "id": "ge-50-4", "type": "buildSentence", "en": "Maybe they have come.", "words": [{ "dari": "شاید", "translit": "shāyad" }, { "dari": "آنها", "translit": "ānhā" }, { "dari": "آمده", "translit": "āmada" }, { "dari": "باشند", "translit": "bāshand" }], "translit": "shāyad ānhā āmada bāshand", "extraWords": [{ "dari": "آمدند", "translit": "āmadand" }] },
            { "id": "ge-50-5", "type": "chooseTranslation", "direction": "toDari", "dari": "شاید کتاب را خوانده باشی", "translit": "shāyad ketāb rā khānda bāshi", "en": "Maybe you have read the book.", "distractorsDari": [{ "dari": "کتاب را خواندی", "translit": "ketāb rā khāndi" }, { "dari": "شاید کتاب را بخوانی", "translit": "shāyad ketāb rā bukhāni" }] },
            { "id": "ge-50-6", "type": "matchPairs", "prompt": "Match certainty and doubt", "pairs": [{ "dari": "رفت", "translit": "raft", "en": "he went" }, { "dari": "رفته است", "translit": "rafta ast", "en": "he has gone" }, { "dari": "رفته باشد", "translit": "rafta bāshad", "en": "he may have gone" }, { "dari": "رفته بود", "translit": "rafta būd", "en": "he had gone" }] }
          ]
        }
      ]
    },
    {
      "id": "gb-17",
      "title": "Impersonal & Passive",
      "subtitle": "When the doer stays hidden",
      "lessons": [
        {
          "id": "gl-51",
          "title": "One can say",
          "subtitle": "Impersonal mētawān",
          "grammarPoint": "impersonal-metawan",
          "grammarPointEn": "The impersonal mētawān + short infinitive expresses 'one can / it is possible to': mētawān guft (one can say); no subject is named.",
          "slides": [
            {
              "id": "gs-51-1",
              "title": "mētawān + short infinitive",
              "body": "For 'one can' or 'it is possible to', use mētawān with a short infinitive (the past stem): mētawān guft — 'one can say'. It has no personal ending.",
              "examples": [
                { "dari": "می‌توان گفت که او خوب است", "translit": "mētawān guft ke ō khōb ast", "en": "One can say that he is good.", "highlight": "می‌توان گفت" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-51-1", "type": "fillBlank", "dari": "___ گفت که او خوب است", "translit": "___ guft ke ō khōb ast", "en": "One can say that he is good.", "answer": { "dari": "می‌توان", "translit": "mētawān" }, "distractors": [{ "dari": "می‌توانم", "translit": "mētawānam" }, { "dari": "باید", "translit": "bāyad" }] },
            { "id": "ge-51-2", "type": "chooseTranslation", "direction": "toEn", "dari": "این کتاب را می‌توان خواند", "translit": "īn ketāb rā mētawān khānd", "en": "One can read this book.", "distractorsEn": ["I can read this book.", "This book must be read."] },
            { "id": "ge-51-3", "type": "spotError", "dari": "می‌توانم دید که او آمد", "translit": "mētawānam dīd ke ō āmad", "en": "One can see that he came.", "errorWord": { "dari": "می‌توانم", "translit": "mētawānam" }, "correction": { "dari": "می‌توان", "translit": "mētawān" }, "hint": "The impersonal form has no personal ending." },
            { "id": "ge-51-4", "type": "buildSentence", "en": "One can say that.", "words": [{ "dari": "آن را", "translit": "ān rā" }, { "dari": "می‌توان", "translit": "mētawān" }, { "dari": "گفت", "translit": "guft" }], "translit": "ān rā mētawān guft", "extraWords": [{ "dari": "می‌گویم", "translit": "mēgōyam" }] },
            { "id": "ge-51-5", "type": "chooseTranslation", "direction": "toDari", "dari": "اینجا می‌توان نان خرید", "translit": "īnjā mētawān nān kharīd", "en": "One can buy bread here.", "distractorsDari": [{ "dari": "اینجا نان می‌خرم", "translit": "īnjā nān mēkharam" }, { "dari": "اینجا باید نان بخری", "translit": "īnjā bāyad nān bukhari" }] },
            { "id": "ge-51-6", "type": "matchPairs", "prompt": "Match personal and impersonal", "pairs": [{ "dari": "می‌توانم بگویم", "translit": "mētawānam bugōyam", "en": "I can say" }, { "dari": "می‌توان گفت", "translit": "mētawān guft", "en": "one can say" }, { "dari": "می‌توانم بخوانم", "translit": "mētawānam bukhānam", "en": "I can read" }, { "dari": "می‌توان خواند", "translit": "mētawān khānd", "en": "one can read" }] }
          ]
        },
        {
          "id": "gl-52",
          "title": "Passive, any tense",
          "subtitle": "shudan across time",
          "grammarPoint": "passive-tenses",
          "grammarPointEn": "The passive across tenses by conjugating shudan: neweshta mēshawad (is written), neweshta shud (was written), neweshta shuda ast (has been written).",
          "slides": [
            {
              "id": "gs-52-1",
              "title": "Move shudan through time",
              "body": "The participle stays; only shudan changes tense: mēshawad (is done), shud (was done), shuda ast (has been done).",
              "table": [["نوشته می‌شود", "is written"], ["نوشته شد", "was written"], ["نوشته شده است", "has been written"]],
              "examples": [
                { "dari": "کتاب نوشته شده است", "translit": "ketāb neweshta shuda ast", "en": "The book has been written.", "highlight": "شده است" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-52-1", "type": "fillBlank", "dari": "کتاب نوشته شده ___", "translit": "ketāb neweshta shuda ___", "en": "The book has been written.", "answer": { "dari": "است", "translit": "ast" }, "distractors": [{ "dari": "شد", "translit": "shud" }, { "dari": "بود", "translit": "būd" }] },
            { "id": "ge-52-2", "type": "chooseTranslation", "direction": "toEn", "dari": "نامه نوشته می‌شود", "translit": "nāma neweshta mēshawad", "en": "The letter is being written.", "distractorsEn": ["The letter was written.", "The letter has been written."] },
            { "id": "ge-52-3", "type": "matchPairs", "prompt": "Match the passive tenses", "pairs": [{ "dari": "دیده می‌شود", "translit": "dīda mēshawad", "en": "is seen" }, { "dari": "دیده شد", "translit": "dīda shud", "en": "was seen" }, { "dari": "دیده شده است", "translit": "dīda shuda ast", "en": "has been seen" }, { "dari": "دیده خواهد شد", "translit": "dīda khāhad shud", "en": "will be seen" }] },
            { "id": "ge-52-4", "type": "buildSentence", "en": "The door has been opened.", "words": [{ "dari": "دروازه", "translit": "darwāza" }, { "dari": "باز", "translit": "bāz" }, { "dari": "شده", "translit": "shuda" }, { "dari": "است", "translit": "ast" }], "translit": "darwāza bāz shuda ast", "extraWords": [{ "dari": "شد", "translit": "shud" }] },
            { "id": "ge-52-5", "type": "spotError", "dari": "کتاب نوشته می‌کند", "translit": "ketāb neweshta mēkunad", "en": "The book is being written.", "errorWord": { "dari": "می‌کند", "translit": "mēkunad" }, "correction": { "dari": "می‌شود", "translit": "mēshawad" }, "hint": "The passive uses shudan, so 'is written' is mēshawad." },
            { "id": "ge-52-6", "type": "chooseTranslation", "direction": "toDari", "dari": "این خانه ساخته شده است", "translit": "īn khāna sākhta shuda ast", "en": "This house has been built.", "distractorsDari": [{ "dari": "این خانه ساخته شد", "translit": "īn khāna sākhta shud" }, { "dari": "این خانه را ساختند", "translit": "īn khāna rā sākhtand" }] }
          ]
        },
        {
          "id": "gl-53",
          "title": "He must have gone",
          "subtitle": "Deduction about the past",
          "grammarPoint": "deduction",
          "grammarPointEn": "Deduction about the past: bāyad + past participle + bāshad (bāyad rafta bāshad = he must have gone) for a confident conclusion.",
          "slides": [
            {
              "id": "gs-53-1",
              "title": "bāyad + participle + bāshad",
              "body": "To conclude that something surely happened, combine bāyad (must) with the past subjunctive: bāyad rafta bāshad — 'he must have gone'.",
              "examples": [
                { "dari": "او باید رفته باشد", "translit": "ō bāyad rafta bāshad", "en": "He must have gone.", "highlight": "باید رفته باشد" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-53-1", "type": "fillBlank", "dari": "او باید ___", "translit": "ō bāyad ___", "en": "He must have gone.", "answer": { "dari": "رفته باشد", "translit": "rafta bāshad" }, "distractors": [{ "dari": "برود", "translit": "burawad" }, { "dari": "رفت", "translit": "raft" }] },
            { "id": "ge-53-2", "type": "chooseTranslation", "direction": "toEn", "dari": "او باید نان خورده باشد", "translit": "ō bāyad nān khurda bāshad", "en": "He must have eaten bread.", "distractorsEn": ["He must eat bread.", "He may have eaten bread."] },
            { "id": "ge-53-3", "type": "buildSentence", "en": "They must have come.", "words": [{ "dari": "آنها", "translit": "ānhā" }, { "dari": "باید", "translit": "bāyad" }, { "dari": "آمده", "translit": "āmada" }, { "dari": "باشند", "translit": "bāshand" }], "translit": "ānhā bāyad āmada bāshand", "extraWords": [{ "dari": "بیایند", "translit": "biāyand" }] },
            { "id": "ge-53-4", "type": "spotError", "dari": "او باید رفته برود", "translit": "ō bāyad rafta burawad", "en": "He must have gone.", "errorWord": { "dari": "برود", "translit": "burawad" }, "correction": { "dari": "باشد", "translit": "bāshad" }, "hint": "Deduction about the past ends in bāshad, not the plain subjunctive." },
            { "id": "ge-53-5", "type": "chooseTranslation", "direction": "toDari", "dari": "او باید کتاب را خوانده باشد", "translit": "ō bāyad ketāb rā khānda bāshad", "en": "He must have read the book.", "distractorsDari": [{ "dari": "او باید کتاب را بخواند", "translit": "ō bāyad ketāb rā bukhānad" }, { "dari": "او کتاب را خواند", "translit": "ō ketāb rā khānd" }] },
            { "id": "ge-53-6", "type": "matchPairs", "prompt": "Match the shades of certainty", "pairs": [{ "dari": "شاید رفته باشد", "translit": "shāyad rafta bāshad", "en": "maybe he went" }, { "dari": "باید رفته باشد", "translit": "bāyad rafta bāshad", "en": "he must have gone" }, { "dari": "رفته است", "translit": "rafta ast", "en": "he has gone" }, { "dari": "باید برود", "translit": "bāyad burawad", "en": "he must go" }] }
          ]
        }
      ]
    },
    {
      "id": "gb-18",
      "title": "Complex Sentences",
      "subtitle": "Clauses within clauses",
      "lessons": [
        {
          "id": "gl-54",
          "title": "The very book that…",
          "subtitle": "Advanced relative clauses",
          "grammarPoint": "advanced-relatives",
          "grammarPointEn": "Relative clauses with a definite antecedent using ān … ke and resumptive structure: ān ketābē ke khāndam (that book which I read); distinguishing defining from adding information.",
          "slides": [
            {
              "id": "gs-54-1",
              "title": "ān … ke",
              "body": "To point precisely, frame the noun with ān (that) and close with ke: ān mardē ke dīdam — 'that man whom I saw'. The clause narrows down exactly which one.",
              "examples": [
                { "dari": "آن کتابی که خواندم، مقبول بود", "translit": "ān ketābē ke khāndam, maqbūl būd", "en": "That book which I read was beautiful.", "highlight": "آن کتابی که" }
              ]
            }
          ],
          "exercises": [
