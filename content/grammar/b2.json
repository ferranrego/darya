          "subtitle": "Reported speech, deeper",
          "grammarPoint": "reported-speech-2",
          "grammarPointEn": "Reported speech across frames: reporting questions and commands with ke and the subjunctive; the reported tense still does not shift back as in English.",
          "slides": [
            {
              "id": "gs-61-1",
              "title": "Reporting asks and orders",
              "body": "To report a request or command, use ke + the subjunctive: guft ke burawam — 'he told me to go'. To report a question, keep the question word after ke.",
              "examples": [
                { "dari": "او گفت که بروم", "translit": "ō guft ke burawam", "en": "He told me to go.", "highlight": "که بروم" },
                { "dari": "پرسید که کجا می‌روم", "translit": "pursīd ke kujā mērawam", "en": "He asked where I was going.", "highlight": "که کجا" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-61-1", "type": "chooseTranslation", "direction": "toEn", "dari": "او گفت که بروم", "translit": "ō guft ke burawam", "en": "He told me to go.", "distractorsEn": ["He said that he is going.", "He said that I went."] },
            { "id": "ge-61-2", "type": "fillBlank", "dari": "پرسید که کجا ___", "translit": "pursīd ke kujā ___", "en": "He asked where I was going.", "answer": { "dari": "می‌روم", "translit": "mērawam" }, "distractors": [{ "dari": "بروم", "translit": "burawam" }, { "dari": "رفتم", "translit": "raftam" }] },
            { "id": "ge-61-3", "type": "spotError", "dari": "معلم گفت که درس می‌خوانم", "translit": "mu'allem guft ke dars mēkhānam", "en": "The teacher told me to study.", "errorWord": { "dari": "می‌خوانم", "translit": "mēkhānam" }, "correction": { "dari": "بخوانم", "translit": "bukhānam" }, "hint": "A reported command takes the subjunctive." },
            { "id": "ge-61-4", "type": "buildSentence", "en": "He told me to come.", "words": [{ "dari": "او", "translit": "ō" }, { "dari": "گفت", "translit": "guft" }, { "dari": "که", "translit": "ke" }, { "dari": "بیایم", "translit": "biāyam" }], "translit": "ō guft ke biāyam", "extraWords": [{ "dari": "می‌آیم", "translit": "mēāyam" }] },
            { "id": "ge-61-5", "type": "chooseTranslation", "direction": "toDari", "dari": "او پرسید که چی می‌خواهم", "translit": "ō pursīd ke che mēkhāham", "en": "He asked what I wanted.", "distractorsDari": [{ "dari": "او پرسید که چی خواستم", "translit": "ō pursīd ke che khāstam" }, { "dari": "او گفت که چی می‌خواهم", "translit": "ō guft ke che mēkhāham" }] },
            { "id": "ge-61-6", "type": "matchPairs", "prompt": "Match statement and report", "pairs": [{ "dari": "می‌روم", "translit": "mērawam", "en": "I go" }, { "dari": "گفت که می‌رود", "translit": "guft ke mērawad", "en": "he said he goes" }, { "dari": "برو", "translit": "bura", "en": "go!" }, { "dari": "گفت که بروم", "translit": "guft ke burawam", "en": "he told me to go" }] }
          ]
        },
        {
          "id": "gl-62",
          "title": "Therefore, on one hand",
          "subtitle": "Discourse connectors",
          "grammarPoint": "discourse-connectors",
          "grammarPointEn": "Higher-level connectors that structure a paragraph: binābar'īn (therefore), az yak taraf … az taraf-e dīgar (on one hand … on the other).",
          "slides": [
            {
              "id": "gs-62-1",
              "title": "Signposting your ideas",
              "body": "These connectors organise longer speech: binābar'īn (therefore) draws a conclusion; az yak taraf … az taraf-e dīgar weighs two sides.",
              "examples": [
                { "dari": "مانده بودم، بنابراین نرفتم", "translit": "mānda būdam, binābar'īn naraftam", "en": "I was tired, therefore I didn't go.", "highlight": "بنابراین" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-62-1", "type": "fillBlank", "dari": "مانده بودم، ___ نرفتم", "translit": "mānda būdam, ___ naraftam", "en": "I was tired, therefore I didn't go.", "answer": { "dari": "بنابراین", "translit": "binābar'īn" }, "distractors": [{ "dari": "اما", "translit": "amā" }, { "dari": "اگر", "translit": "agar" }] },
            { "id": "ge-62-2", "type": "chooseTranslation", "direction": "toEn", "dari": "باران بود، بنابراین خانه ماندیم", "translit": "bārān būd, binābar'īn khāna māndēm", "en": "It was raining, therefore we stayed home.", "distractorsEn": ["It was raining, but we stayed home.", "If it rains, we stay home."] },
            { "id": "ge-62-3", "type": "buildSentence", "en": "He was sick, therefore he didn't come.", "words": [{ "dari": "مریض", "translit": "marīz" }, { "dari": "بود", "translit": "būd" }, { "dari": "بنابراین", "translit": "binābar'īn" }, { "dari": "نیامد", "translit": "nayāmad" }], "translit": "marīz būd, binābar'īn nayāmad", "extraWords": [{ "dari": "چون", "translit": "chun" }] },
            { "id": "ge-62-4", "type": "chooseTranslation", "direction": "toDari", "dari": "او کار کرد، بنابراین مانده است", "translit": "ō kār kard, binābar'īn mānda ast", "en": "He worked, therefore he is tired.", "distractorsDari": [{ "dari": "او کار کرد اما مانده است", "translit": "ō kār kard amā mānda ast" }, { "dari": "او مانده است چون کار می‌کند", "translit": "ō mānda ast chun kār mēkunad" }] },
            { "id": "ge-62-5", "type": "matchPairs", "prompt": "Match the connectors", "pairs": [{ "dari": "بنابراین", "translit": "binābar'īn", "en": "therefore" }, { "dari": "زیرا", "translit": "zērā", "en": "because" }, { "dari": "هرچند", "translit": "harchand", "en": "even though" }, { "dari": "اما", "translit": "amā", "en": "but" }] },
            { "id": "ge-62-6", "type": "spotError", "dari": "مانده بودم، اگر نرفتم", "translit": "mānda būdam, agar naraftam", "en": "I was tired, therefore I didn't go.", "errorWord": { "dari": "اگر", "translit": "agar" }, "correction": { "dari": "بنابراین", "translit": "binābar'īn" }, "hint": "This draws a conclusion — 'therefore', not 'if'." }
          ]
        },
