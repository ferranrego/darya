            { "id": "ge-54-5", "type": "chooseTranslation", "direction": "toDari", "dari": "آن خانه‌ای که خریدم، کلان است", "translit": "ān khāna-ē ke kharīdam, kalān ast", "en": "That house which I bought is big.", "distractorsDari": [{ "dari": "خانه‌ای خریدم که کلان است", "translit": "khāna-ē kharīdam ke kalān ast" }, { "dari": "آن خانه کلان است", "translit": "ān khāna kalān ast" }] },
            { "id": "ge-54-6", "type": "fillBlank", "dari": "___ کتابی که خواندم، خوب بود", "translit": "___ ketābē ke khāndam, khōb būd", "en": "That book which I read was good.", "answer": { "dari": "آن", "translit": "ān" }, "distractors": [{ "dari": "این", "translit": "īn" }, { "dari": "هر", "translit": "har" }] }
          ]
