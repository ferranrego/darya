            { "id": "ge-63-3", "type": "chooseTranslation", "direction": "toEn", "dari": "این کتاب را می‌توان خواند", "translit": "īn ketāb rā mētawān khānd", "en": "One can read this book.", "distractorsEn": ["I can read this book.", "This book must be read."] },
