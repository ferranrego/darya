  "blocks": [
    {
      "id": "gb-26",
      "title": "Elevated Register",
      "subtitle": "Formal address and diction",
      "lessons": [
        {
          "id": "gl-79",
          "title": "With respect",
          "subtitle": "Formal address",
          "grammarPoint": "formal-address",
          "grammarPointEn": "Formal address and honorifics: mohtaram (respected), jenāb (sir/His Excellency), and the polite plural shumā for a single addressee in official settings.",
          "slides": [
            {
              "id": "gs-79-1",
              "title": "Speaking with deference",
              "body": "In official Dari you address people with honorifics: mohtaram (respected) before a title, jenāb (sir) for high standing, and always the polite plural shumā.",
              "examples": [
                { "dari": "معلم محترم، خوش آمدید", "translit": "mu'allem-e mohtaram, khush āmadēd", "en": "Respected teacher, welcome.", "highlight": "محترم" },
                { "dari": "جناب رئیس تشریف آوردند", "translit": "jenāb-e ra'īs tashrīf āwardand", "en": "His Excellency the chief arrived.", "highlight": "جناب" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-79-1", "type": "fillBlank", "dari": "معلم ___، خوش آمدید", "translit": "mu'allem-e ___, khush āmadēd", "en": "Respected teacher, welcome.", "answer": { "dari": "محترم", "translit": "mohtaram" }, "distractors": [{ "dari": "خورد", "translit": "khurd" }, { "dari": "مانده", "translit": "mānda" }] },
            { "id": "ge-79-2", "type": "chooseTranslation", "direction": "toEn", "dari": "جناب رئیس آمدند", "translit": "jenāb-e ra'īs āmadand", "en": "His Excellency the chief came.", "distractorsEn": ["The chief's friend came.", "The chief will come."] },
            { "id": "ge-79-3", "type": "matchPairs", "prompt": "Match register", "pairs": [{ "dari": "محترم", "translit": "mohtaram", "en": "respected" }, { "dari": "جناب", "translit": "jenāb", "en": "sir / Excellency" }, { "dari": "شما", "translit": "shumā", "en": "you (polite)" }, { "dari": "تو", "translit": "tu", "en": "you (familiar)" }] },
            { "id": "ge-79-4", "type": "chooseTranslation", "direction": "toDari", "dari": "دوست محترم، تشکر", "translit": "dōst-e mohtaram, tashakur", "en": "Respected friend, thank you.", "distractorsDari": [{ "dari": "دوست خوب، تشکر", "translit": "dōst-e khōb, tashakur" }, { "dari": "دوست محترم، سلام", "translit": "dōst-e mohtaram, salām" }] },
            { "id": "ge-79-5", "type": "spotError", "dari": "جناب رئیس، تو کجا می‌روی؟", "translit": "jenāb-e ra'īs, tu kujā mērawi?", "en": "Your Excellency, where are you going?", "errorWord": { "dari": "می‌روی", "translit": "mērawi" }, "correction": { "dari": "می‌روید", "translit": "mērawēd" }, "hint": "An honorific address takes the polite plural form." },
            { "id": "ge-79-6", "type": "fillBlank", "dari": "___ رئیس، خوش آمدید", "translit": "___ ra'īs, khush āmadēd", "en": "Your Excellency the chief, welcome.", "answer": { "dari": "جناب", "translit": "jenāb" }, "distractors": [{ "dari": "دوست", "translit": "dōst" }, { "dari": "برادر", "translit": "barādar" }] }
          ]
        },
        {
          "id": "gl-80",
          "title": "The bureaucratic voice",
          "subtitle": "Official verbs and passives",
          "grammarPoint": "official-style",
          "grammarPointEn": "Bureaucratic/official style: heavy use of the passive and formal verbs (namūdan, gardīdan) to sound impersonal and authoritative.",
          "slides": [
            {
              "id": "gs-80-1",
              "title": "Impersonal authority",
              "body": "Official writing prefers the passive and the formal verbs, hiding the doer: 'the letter was signed', 'the decision was made'. It sounds neutral and authoritative.",
              "examples": [
                { "dari": "تصمیم گرفته شد", "translit": "tasmīm gerefta shud", "en": "The decision was made.", "highlight": "گرفته شد" },
                { "dari": "کار تمام گردید", "translit": "kār tamām gardīd", "en": "The work was completed. (formal)", "highlight": "گردید" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-80-1", "type": "chooseTranslation", "direction": "toEn", "dari": "تصمیم گرفته شد", "translit": "tasmīm gerefta shud", "en": "The decision was made.", "distractorsEn": ["He made a decision.", "The decision will be made."] },
            { "id": "ge-80-2", "type": "fillBlank", "dari": "کار تمام ___", "translit": "kār tamām ___", "en": "The work was completed. (formal)", "answer": { "dari": "گردید", "translit": "gardīd" }, "distractors": [{ "dari": "کرد", "translit": "kard" }, { "dari": "دید", "translit": "dīd" }] },
            { "id": "ge-80-3", "type": "matchPairs", "prompt": "Match plain and official", "pairs": [{ "dari": "تصمیم گرفت", "translit": "tasmīm gereft", "en": "he decided" }, { "dari": "تصمیم گرفته شد", "translit": "tasmīm gerefta shud", "en": "the decision was made" }, { "dari": "تمام کرد", "translit": "tamām kard", "en": "he finished" }, { "dari": "تمام گردید", "translit": "tamām gardīd", "en": "it was finished" }] },
            { "id": "ge-80-4", "type": "buildSentence", "en": "The letter was written. (formal)", "words": [{ "dari": "نامه", "translit": "nāma" }, { "dari": "نوشته", "translit": "neweshta" }, { "dari": "گردید", "translit": "gardīd" }], "translit": "nāma neweshta gardīd", "extraWords": [{ "dari": "کرد", "translit": "kard" }] },
            { "id": "ge-80-5", "type": "chooseTranslation", "direction": "toDari", "dari": "این کار انجام داده شد", "translit": "īn kār anjām dāda shud", "en": "This task was carried out.", "distractorsDari": [{ "dari": "این کار را کردم", "translit": "īn kār rā kardam" }, { "dari": "این کار انجام می‌شود", "translit": "īn kār anjām mēshawad" }] },
            { "id": "ge-80-6", "type": "spotError", "dari": "نامه امضا کرده شد توسط رئیس", "translit": "nāma emzā karda shud tawassot-e ra'īs", "en": "The letter was signed by the chief.", "errorWord": { "dari": "کرده", "translit": "karda" }, "correction": { "dari": "شده", "translit": "shuda" }, "hint": "'was signed' pairs the participle with shudan, not kardan." }
          ]
        },
        {
          "id": "gl-81",
          "title": "Precision in meaning",
          "subtitle": "manzūr, qasd, ma'nā",
          "grammarPoint": "meaning-nuance",
          "grammarPointEn": "Talking about meaning and intent precisely: manzūr (what one means), qasd (intention), ma'nā (the meaning of a word) — distinguishing subtle senses.",
          "slides": [
            {
              "id": "gs-81-1",
              "title": "Meaning vs intention",
              "body": "ma'nā is the meaning of a word or phrase; manzūr is what a speaker means; qasd is intention (what one plans). Precise speakers keep them apart.",
              "examples": [
                { "dari": "منظور من این بود", "translit": "manzūr-e man īn būd", "en": "What I meant was this.", "highlight": "منظور" },
                { "dari": "معنی این کلمه چیست؟", "translit": "ma'nā-ye īn kalema chīst?", "en": "What is the meaning of this word?", "highlight": "معنی" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-81-1", "type": "fillBlank", "dari": "___ من این بود", "translit": "___ man īn būd", "en": "What I meant was this.", "answer": { "dari": "منظور", "translit": "manzūr" }, "distractors": [{ "dari": "معنی", "translit": "ma'nā" }, { "dari": "قصد", "translit": "qasd" }] },
            { "id": "ge-81-2", "type": "chooseTranslation", "direction": "toEn", "dari": "معنی این کلمه چیست؟", "translit": "ma'nā-ye īn kalema chīst?", "en": "What is the meaning of this word?", "distractorsEn": ["What is your intention?", "What is this word's name?"] },
            { "id": "ge-81-3", "type": "matchPairs", "prompt": "Match the fine senses", "pairs": [{ "dari": "معنی", "translit": "ma'nā", "en": "meaning (of a word)" }, { "dari": "منظور", "translit": "manzūr", "en": "what one means" }, { "dari": "قصد", "translit": "qasd", "en": "intention" }, { "dari": "کلمه", "translit": "kalema", "en": "word" }] },
            { "id": "ge-81-4", "type": "chooseTranslation", "direction": "toDari", "dari": "قصد رفتن داشتم", "translit": "qasd-e raftan dāshtam", "en": "I intended to go.", "distractorsDari": [{ "dari": "معنی رفتن را دانستم", "translit": "ma'nā-ye raftan rā dānistam" }, { "dari": "منظور رفتن بود", "translit": "manzūr raftan būd" }] },
            { "id": "ge-81-5", "type": "fillBlank", "dari": "___ این کلمه را نمی‌دانم", "translit": "___ īn kalema rā namēdānam", "en": "I don't know the meaning of this word.", "answer": { "dari": "معنی", "translit": "ma'nā" }, "distractors": [{ "dari": "قصد", "translit": "qasd" }, { "dari": "خیال", "translit": "khayāl" }] },
            { "id": "ge-81-6", "type": "spotError", "dari": "قصد این کلمه چیست؟", "translit": "qasd-e īn kalema chīst?", "en": "What is the meaning of this word?", "errorWord": { "dari": "قصد", "translit": "qasd" }, "correction": { "dari": "معنی", "translit": "ma'nā" }, "hint": "A word has a ma'nā (meaning); qasd is a person's intention." }
          ]
        }
      ]
    },
    {
      "id": "gb-27",
      "title": "Literary Shapes",
      "subtitle": "Emphasis, inversion, heavy phrases",
      "lessons": [
        {
          "id": "gl-82",
          "title": "The emphatic self",
          "subtitle": "khud and its weight",
          "grammarPoint": "emphatic-khud",
          "grammarPointEn": "Emphatic and reflexive khud: khudam āmadam (I myself came), khud-e ra'īs (the chief himself); doubling for strong emphasis.",
          "slides": [
            {
              "id": "gs-82-1",
              "title": "…himself, …myself",
              "body": "khud plus a possessive gives emphasis: khudam (myself), khud-e ō (himself). Placed by the subject, it stresses 'that very one, in person'.",
              "examples": [
                { "dari": "خودم او را دیدم", "translit": "khudam ō rā dīdam", "en": "I myself saw him.", "highlight": "خودم" },
                { "dari": "خود رئیس آمد", "translit": "khud-e ra'īs āmad", "en": "The chief himself came.", "highlight": "خود رئیس" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-82-1", "type": "fillBlank", "dari": "___ او را دیدم", "translit": "___ ō rā dīdam", "en": "I myself saw him.", "answer": { "dari": "خودم", "translit": "khudam" }, "distractors": [{ "dari": "خودت", "translit": "khudat" }, { "dari": "خودش", "translit": "khudash" }] },
            { "id": "ge-82-2", "type": "chooseTranslation", "direction": "toEn", "dari": "خود رئیس آمد", "translit": "khud-e ra'īs āmad", "en": "The chief himself came.", "distractorsEn": ["The chief's friend came.", "The chief came for himself."] },
            { "id": "ge-82-3", "type": "matchPairs", "prompt": "Match the emphatic forms", "pairs": [{ "dari": "خودم", "translit": "khudam", "en": "myself" }, { "dari": "خودت", "translit": "khudat", "en": "yourself" }, { "dari": "خودش", "translit": "khudash", "en": "himself" }, { "dari": "خود ما", "translit": "khud-e mā", "en": "ourselves" }] },
            { "id": "ge-82-4", "type": "buildSentence", "en": "I did the work myself.", "words": [{ "dari": "کار را", "translit": "kār rā" }, { "dari": "خودم", "translit": "khudam" }, { "dari": "کردم", "translit": "kardam" }], "translit": "kār rā khudam kardam", "extraWords": [{ "dari": "خودش", "translit": "khudash" }] },
            { "id": "ge-82-5", "type": "chooseTranslation", "direction": "toDari", "dari": "خودت این را نوشتی؟", "translit": "khudat īn rā neweshti?", "en": "Did you write this yourself?", "distractorsDari": [{ "dari": "خودم این را نوشتم؟", "translit": "khudam īn rā neweshtam?" }, { "dari": "این را نوشتی؟", "translit": "īn rā neweshti?" }] },
            { "id": "ge-82-6", "type": "fillBlank", "dari": "___ رئیس نامه را امضا کرد", "translit": "___ ra'īs nāma rā emzā kard", "en": "The chief himself signed the letter.", "answer": { "dari": "خود", "translit": "khud-e" }, "distractors": [{ "dari": "خودم", "translit": "khudam" }, { "dari": "برای", "translit": "barāye" }] }
          ]
        },
        {
          "id": "gl-83",
          "title": "Fronting for effect",
          "subtitle": "Marked word order",
          "grammarPoint": "fronting",
          "grammarPointEn": "Marked word order: moving an object or adverb to the front for emphasis, keeping the verb final: īn ketāb rā man khāndam (THIS book, I read).",
          "slides": [
            {
              "id": "gs-83-1",
              "title": "Put the focus first",
              "body": "Dari usually runs subject–object–verb, but you can front the element you want to stress. 'This book, I read' puts the spotlight on the book.",
              "examples": [
                { "dari": "این کتاب را من خواندم", "translit": "īn ketāb rā man khāndam", "en": "This book, I read (it).", "highlight": "این کتاب را" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-83-1", "type": "chooseTranslation", "direction": "toEn", "dari": "این کتاب را من خواندم", "translit": "īn ketāb rā man khāndam", "en": "This book, I read.", "distractorsEn": ["I read a book.", "This is the book I write."] },
            { "id": "ge-83-2", "type": "buildSentence", "en": "That letter, he wrote (it).", "words": [{ "dari": "آن نامه را", "translit": "ān nāma rā" }, { "dari": "او", "translit": "ō" }, { "dari": "نوشت", "translit": "newesht" }], "translit": "ān nāma rā ō newesht", "extraWords": [{ "dari": "نوشتم", "translit": "neweshtam" }] },
            { "id": "ge-83-3", "type": "spotError", "dari": "این کار را من می‌کند", "translit": "īn kār rā man mēkunad", "en": "This work, I do (it).", "errorWord": { "dari": "می‌کند", "translit": "mēkunad" }, "correction": { "dari": "می‌کنم", "translit": "mēkunam" }, "hint": "Even when fronted, the verb agrees with the subject 'I'." },
            { "id": "ge-83-4", "type": "chooseTranslation", "direction": "toDari", "dari": "امروز به کابل می‌رویم", "translit": "emrōz ba kābul mērawēm", "en": "Today, we go to Kabul.", "distractorsDari": [{ "dari": "به کابل امروز می‌رویم", "translit": "ba kābul emrōz mērawēm" }, { "dari": "امروز کابل را می‌بینیم", "translit": "emrōz kābul rā mēbīnēm" }] },
            { "id": "ge-83-5", "type": "matchPairs", "prompt": "Match neutral and fronted", "pairs": [{ "dari": "من کتاب را خواندم", "translit": "man ketāb rā khāndam", "en": "I read the book" }, { "dari": "کتاب را من خواندم", "translit": "ketāb rā man khāndam", "en": "the book, I read" }, { "dari": "او نامه نوشت", "translit": "ō nāma newesht", "en": "he wrote a letter" }, { "dari": "نامه را او نوشت", "translit": "nāma rā ō newesht", "en": "the letter, he wrote" }] },
            { "id": "ge-83-6", "type": "fillBlank", "dari": "این نان را ___ خوردم", "translit": "īn nān rā ___ khurdam", "en": "This bread, I ate.", "answer": { "dari": "من", "translit": "man" }, "distractors": [{ "dari": "او", "translit": "ō" }, { "dari": "آنها", "translit": "ānhā" }] }
          ]
        },
        {
          "id": "gl-84",
          "title": "Heavy noun phrases",
          "subtitle": "Long ezafe chains",
          "grammarPoint": "ezafe-chains",
          "grammarPointEn": "Reading long ezāfa chains that stack modifiers and possessors: ketāb-e naw-e mu'allem-e mektab-e mā (our school's teacher's new book).",
          "slides": [
            {
              "id": "gs-84-1",
              "title": "Following the chain",
              "body": "Formal Dari builds long ezāfa chains, each -e linking to the next. Read them from the head noun outward: 'book — new — of the teacher — of our school'.",
              "examples": [
                { "dari": "کتاب نو معلم مکتب ما", "translit": "ketāb-e naw-e mu'allem-e maktab-e mā", "en": "The new book of our school's teacher.", "highlight": "معلم مکتب ما" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-84-1", "type": "chooseTranslation", "direction": "toEn", "dari": "کتاب نو معلم مکتب ما", "translit": "ketāb-e naw-e mu'allem-e maktab-e mā", "en": "The new book of our school's teacher.", "distractorsEn": ["Our teacher's new school book.", "The teacher of our new book's school."] },
            { "id": "ge-84-2", "type": "buildSentence", "en": "The door of my father's house.", "words": [{ "dari": "دروازه", "translit": "darwāza-ye" }, { "dari": "خانه", "translit": "khāna-ye" }, { "dari": "پدر", "translit": "padar-e" }, { "dari": "من", "translit": "man" }], "translit": "darwāza-ye khāna-ye padar-e man", "extraWords": [{ "dari": "را", "translit": "rā" }] },
            { "id": "ge-84-3", "type": "chooseTranslation", "direction": "toEn", "dari": "نام دوست خوب برادر من", "translit": "nām-e dōst-e khōb-e barādar-e man", "en": "The name of my brother's good friend.", "distractorsEn": ["My good friend's brother's name.", "The good name of my brother's friend."] },
            { "id": "ge-84-4", "type": "matchPairs", "prompt": "Match phrase and meaning", "pairs": [{ "dari": "خانه پدر من", "translit": "khāna-ye padar-e man", "en": "my father's house" }, { "dari": "کتاب معلم", "translit": "ketāb-e mu'allem", "en": "the teacher's book" }, { "dari": "دوست خوب من", "translit": "dōst-e khōb-e man", "en": "my good friend" }, { "dari": "شهر کلان ما", "translit": "shahr-e kalān-e mā", "en": "our big city" }] },
            { "id": "ge-84-5", "type": "chooseTranslation", "direction": "toDari", "dari": "قلم نو دختر معلم", "translit": "qalam-e naw-e dukhtar-e mu'allem", "en": "The teacher's daughter's new pen.", "distractorsDari": [{ "dari": "قلم نو معلم دختر", "translit": "qalam-e naw-e mu'allem-e dukhtar" }, { "dari": "دختر معلم قلم نو", "translit": "dukhtar-e mu'allem-e qalam-e naw" }] },
            { "id": "ge-84-6", "type": "fillBlank", "dari": "کتاب ___ برادر من مقبول است", "translit": "ketāb-e ___ barādar-e man maqbūl ast", "en": "My brother's new book is beautiful.", "answer": { "dari": "نو", "translit": "naw-e" }, "distractors": [{ "dari": "را", "translit": "rā" }, { "dari": "با", "translit": "bā" }] }
          ]
        }
      ]
    },
    {
      "id": "gb-28",
      "title": "Idiom & Image",
      "subtitle": "Sayings and figurative language",
      "lessons": [
        {
          "id": "gl-85",
          "title": "Words of wisdom",
          "subtitle": "Proverbs",
          "grammarPoint": "proverbs",
          "grammarPointEn": "Understanding common proverbs (zarb-ul-masal) whose meaning is figurative rather than literal.",
          "slides": [
            {
              "id": "gs-85-1",
              "title": "Meaning beyond the words",
              "body": "Proverbs carry a lesson under a literal picture. Learn a few common ones and their intended sense.",
              "examples": [
                { "dari": "قطره قطره دریا می‌شود", "translit": "qatra qatra daryā mēshawad", "en": "Drop by drop it becomes a river. (small efforts add up)", "highlight": "قطره قطره" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-85-1", "type": "chooseTranslation", "direction": "toEn", "dari": "قطره قطره دریا می‌شود", "translit": "qatra qatra daryā mēshawad", "en": "Small efforts add up over time.", "distractorsEn": ["Rivers are made of water.", "A drop cannot fill a river."] },
            { "id": "ge-85-2", "type": "chooseTranslation", "direction": "toEn", "dari": "کار امروز را به فردا نکن", "translit": "kār-e emrōz rā ba fardā nakun", "en": "Don't leave today's work for tomorrow.", "distractorsEn": ["Do tomorrow's work today.", "Today's work is for tomorrow."] },
            { "id": "ge-85-3", "type": "matchPairs", "prompt": "Match proverb and lesson", "pairs": [{ "dari": "قطره قطره دریا می‌شود", "translit": "qatra qatra daryā mēshawad", "en": "small efforts add up" }, { "dari": "وقت طلا است", "translit": "waqt talā ast", "en": "time is precious" }, { "dari": "کتاب بهترین دوست است", "translit": "ketāb bihtarīn dōst ast", "en": "a book is the best friend" }, { "dari": "وقت رفته باز نمی‌آید", "translit": "waqt-e rafta bāz namēāyad", "en": "lost time never returns" }] },
            { "id": "ge-85-4", "type": "chooseTranslation", "direction": "toEn", "dari": "وقت طلا است", "translit": "waqt talā ast", "en": "Time is precious.", "distractorsEn": ["Gold takes time.", "Time is money to buy gold."] },
            { "id": "ge-85-5", "type": "fillBlank", "dari": "قطره قطره ___ می‌شود", "translit": "qatra qatra ___ mēshawad", "en": "Drop by drop it becomes a river.", "answer": { "dari": "دریا", "translit": "daryā" }, "distractors": [{ "dari": "کوه", "translit": "kōh" }, { "dari": "باران", "translit": "bārān" }] },
            { "id": "ge-85-6", "type": "chooseTranslation", "direction": "toEn", "dari": "دیر آی و درست آی", "translit": "dēr āy wa durust āy", "en": "Better to arrive late but do it right.", "distractorsEn": ["Come late and leave right.", "Right people come late."] }
          ]
        },
        {
          "id": "gl-86",
          "title": "The language of the body",
          "subtitle": "Idioms with dil, dast, sar",
          "grammarPoint": "body-idioms",
          "grammarPointEn": "Figurative idioms built on body parts: dil (heart) for feeling, dast (hand) for action/possession, sar (head) for mind/beginning.",
          "slides": [
            {
              "id": "gs-86-1",
              "title": "Body parts, big meanings",
              "body": "dil (heart) carries emotion, dast (hand) carries action or having, sar (head) carries thought. dilam mēkhāhad — 'my heart wants', i.e. 'I feel like'.",
              "examples": [
                { "dari": "دلم می‌خواهد بروم", "translit": "dilam mēkhāhad burawam", "en": "I feel like going.", "highlight": "دلم می‌خواهد" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-86-1", "type": "chooseTranslation", "direction": "toEn", "dari": "دلم می‌خواهد بروم", "translit": "dilam mēkhāhad burawam", "en": "I feel like going.", "distractorsEn": ["My heart is going.", "I must go."] },
            { "id": "ge-86-2", "type": "matchPairs", "prompt": "Match the body idioms", "pairs": [{ "dari": "دلم می‌خواهد", "translit": "dilam mēkhāhad", "en": "I feel like" }, { "dari": "از دست دادن", "translit": "az dast dādan", "en": "to lose" }, { "dari": "به سر بردن", "translit": "ba sar burdan", "en": "to spend (time)" }, { "dari": "به یاد داشتن", "translit": "ba yād dāshtan", "en": "to keep in mind" }] },
            { "id": "ge-86-3", "type": "fillBlank", "dari": "___ می‌خواهد چای بخورم", "translit": "___ mēkhāhad chāy bukhuram", "en": "I feel like drinking tea.", "answer": { "dari": "دلم", "translit": "dilam" }, "distractors": [{ "dari": "سرم", "translit": "saram" }, { "dari": "دستم", "translit": "dastam" }] },
            { "id": "ge-86-4", "type": "chooseTranslation", "direction": "toEn", "dari": "روز را به کار به سر برد", "translit": "rōz rā ba kār ba sar burd", "en": "He spent the day working.", "distractorsEn": ["He carried work on his head.", "He worked for a day's pay."] },
            { "id": "ge-86-5", "type": "chooseTranslation", "direction": "toDari", "dari": "دلش نمی‌خواهد بیاید", "translit": "dilash namēkhāhad biāyad", "en": "He doesn't feel like coming.", "distractorsDari": [{ "dari": "دلم نمی‌خواهد بیایم", "translit": "dilam namēkhāhad biāyam" }, { "dari": "او نمی‌خواهد بیاید", "translit": "ō namēkhāhad biāyad" }] },
            { "id": "ge-86-6", "type": "spotError", "dari": "سرم می‌خواهد بخوابم", "translit": "saram mēkhāhad bukhābam", "en": "I feel like sleeping.", "errorWord": { "dari": "سرم", "translit": "saram" }, "correction": { "dari": "دلم", "translit": "dilam" }, "hint": "'To feel like' uses dil (heart), not sar (head)." }
          ]
        },
        {
          "id": "gl-87",
          "title": "Figurative light verbs",
          "subtitle": "Metaphor in everyday verbs",
          "grammarPoint": "figurative-verbs",
          "grammarPointEn": "Light-verb expressions with figurative meaning: ba dast āwardan (to gain), az dast dādan (to lose), ba kār burdan (to employ/use).",
          "slides": [
            {
              "id": "gs-87-1",
              "title": "Verbs that carry images",
              "body": "Many abstract meanings ride on concrete verbs. ba dast āwardan (bring to hand) = 'gain'; ba kār burdan (carry to work) = 'use/apply'.",
              "examples": [
                { "dari": "تجربه به دست آورد", "translit": "tajroba ba dast āward", "en": "He gained experience.", "highlight": "به دست آورد" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-87-1", "type": "chooseTranslation", "direction": "toEn", "dari": "تجربه به دست آورد", "translit": "tajroba ba dast āward", "en": "He gained experience.", "distractorsEn": ["He lost experience.", "He gave experience by hand."] },
            { "id": "ge-87-2", "type": "matchPairs", "prompt": "Match the figurative verbs", "pairs": [{ "dari": "به دست آوردن", "translit": "ba dast āwardan", "en": "to gain" }, { "dari": "از دست دادن", "translit": "az dast dādan", "en": "to lose" }, { "dari": "به کار بردن", "translit": "ba kār burdan", "en": "to use" }, { "dari": "به یاد آوردن", "translit": "ba yād āwardan", "en": "to recall" }] },
            { "id": "ge-87-3", "type": "fillBlank", "dari": "این کلمه را در نوشته خود به کار ___", "translit": "īn kalema rā dar neweshta-ye khud ba kār ___", "en": "He used this word in his writing.", "answer": { "dari": "برد", "translit": "burd" }, "distractors": [{ "dari": "داد", "translit": "dād" }, { "dari": "آورد", "translit": "āward" }] },
            { "id": "ge-87-4", "type": "chooseTranslation", "direction": "toDari", "dari": "او فرصت خود را از دست داد", "translit": "ō forsat-e khud rā az dast dād", "en": "He lost his opportunity.", "distractorsDari": [{ "dari": "او فرصت خود را به دست آورد", "translit": "ō forsat-e khud rā ba dast āward" }, { "dari": "او فرصت خود را به کار برد", "translit": "ō forsat-e khud rā ba kār burd" }] },
            { "id": "ge-87-5", "type": "spotError", "dari": "تجربه از دست آورد", "translit": "tajroba az dast āward", "en": "He gained experience.", "errorWord": { "dari": "از", "translit": "az" }, "correction": { "dari": "به", "translit": "ba" }, "hint": "'To gain' is ba dast (to hand), not az dast (from hand)." },
            { "id": "ge-87-6", "type": "buildSentence", "en": "He used this idea.", "words": [{ "dari": "این خیال را", "translit": "īn khayāl rā" }, { "dari": "به کار", "translit": "ba kār" }, { "dari": "برد", "translit": "burd" }], "translit": "īn khayāl rā ba kār burd", "extraWords": [{ "dari": "داد", "translit": "dād" }] }
          ]
        }
      ]
    },
    {
      "id": "gb-29",
      "title": "Discourse Mastery",
      "subtitle": "Structuring long argument",
      "lessons": [
        {
          "id": "gl-88",
          "title": "On one hand, on the other",
          "subtitle": "Balancing two sides",
          "grammarPoint": "balancing",
          "grammarPointEn": "Weighing arguments with az yak sū / az yak taraf … az sū-ye dīgar / az taraf-e dīgar (on one hand … on the other).",
          "slides": [
            {
              "id": "gs-88-1",
              "title": "Two sides of a case",
              "body": "To present balanced views, open with az yak sū (on one hand) and answer with az sū-ye dīgar (on the other). It signals fair, structured argument.",
              "examples": [
                { "dari": "از یک سو خوب است، از سوی دیگر گران است", "translit": "az yak sū khōb ast, az sū-ye dīgar gerān ast", "en": "On one hand it's good, on the other it's expensive.", "highlight": "از یک سو" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-88-1", "type": "fillBlank", "dari": "___ خوب است، از سوی دیگر گران است", "translit": "___ khōb ast, az sū-ye dīgar gerān ast", "en": "On one hand it's good, on the other it's expensive.", "answer": { "dari": "از یک سو", "translit": "az yak sū" }, "distractors": [{ "dari": "اگرچه", "translit": "agarche" }, { "dari": "بنابراین", "translit": "binābar'īn" }] },
            { "id": "ge-88-2", "type": "chooseTranslation", "direction": "toEn", "dari": "از یک طرف آسان، از طرف دیگر خطرناک است", "translit": "az yak taraf āsān, az taraf-e dīgar khatarnāk ast", "en": "On one hand easy, on the other dangerous.", "distractorsEn": ["It is easy and safe.", "One way is dangerous and hard."] },
            { "id": "ge-88-3", "type": "buildSentence", "en": "On one hand he is tired, on the other he is happy.", "words": [{ "dari": "از یک سو", "translit": "az yak sū" }, { "dari": "مانده است", "translit": "mānda ast" }, { "dari": "از سوی دیگر", "translit": "az sū-ye dīgar" }, { "dari": "خوش است", "translit": "khush ast" }], "translit": "az yak sū mānda ast, az sū-ye dīgar khush ast", "extraWords": [{ "dari": "بنابراین", "translit": "binābar'īn" }] },
            { "id": "ge-88-4", "type": "matchPairs", "prompt": "Match the balancing phrases", "pairs": [{ "dari": "از یک سو", "translit": "az yak sū", "en": "on one hand" }, { "dari": "از سوی دیگر", "translit": "az sū-ye dīgar", "en": "on the other hand" }, { "dari": "به هر حال", "translit": "ba har hāl", "en": "in any case" }, { "dari": "بنابراین", "translit": "binābar'īn", "en": "therefore" }] },
            { "id": "ge-88-5", "type": "chooseTranslation", "direction": "toDari", "dari": "به هر حال، ما می‌رویم", "translit": "ba har hāl, mā mērawēm", "en": "In any case, we are going.", "distractorsDari": [{ "dari": "از یک سو، ما می‌رویم", "translit": "az yak sū, mā mērawēm" }, { "dari": "بنابراین ما می‌رویم", "translit": "binābar'īn mā mērawēm" }] },
            { "id": "ge-88-6", "type": "fillBlank", "dari": "از یک سو ارزان، ___ خراب است", "translit": "az yak sū arzān, ___ kharāb ast", "en": "On one hand cheap, on the other broken.", "answer": { "dari": "از سوی دیگر", "translit": "az sū-ye dīgar" }, "distractors": [{ "dari": "چون", "translit": "chun" }, { "dari": "وگرنه", "translit": "wa gar na" }] }
          ]
        },
        {
          "id": "gl-89",
          "title": "Hedging your claim",
          "subtitle": "ehtemālan, ba gumān-e man",
          "grammarPoint": "hedging-stance",
          "grammarPointEn": "Marking stance and probability: ehtemālan (probably), ba gumān-e man (in my opinion), ba har hāl (in any case).",
          "slides": [
            {
              "id": "gs-89-1",
              "title": "How sure are you?",
              "body": "Careful writers mark how strongly they claim something: ehtemālan (probably), ba gumān-e man (in my view). These soften or frame an assertion.",
              "examples": [
                { "dari": "احتمالاً فردا می‌آید", "translit": "ehtemālan fardā mēāyad", "en": "He'll probably come tomorrow.", "highlight": "احتمالاً" },
                { "dari": "به گمان من، این درست است", "translit": "ba gumān-e man, īn durust ast", "en": "In my opinion, this is right.", "highlight": "به گمان من" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-89-1", "type": "fillBlank", "dari": "___ فردا می‌آید", "translit": "___ fardā mēāyad", "en": "He'll probably come tomorrow.", "answer": { "dari": "احتمالاً", "translit": "ehtemālan" }, "distractors": [{ "dari": "حتماً", "translit": "hatman" }, { "dari": "هرگز", "translit": "hargez" }] },
            { "id": "ge-89-2", "type": "chooseTranslation", "direction": "toEn", "dari": "به گمان من، این درست است", "translit": "ba gumān-e man, īn durust ast", "en": "In my opinion, this is right.", "distractorsEn": ["I am sure this is wrong.", "In his opinion, this is right."] },
            { "id": "ge-89-3", "type": "matchPairs", "prompt": "Match the stance markers", "pairs": [{ "dari": "احتمالاً", "translit": "ehtemālan", "en": "probably" }, { "dari": "حتماً", "translit": "hatman", "en": "certainly" }, { "dari": "به گمان من", "translit": "ba gumān-e man", "en": "in my opinion" }, { "dari": "شاید", "translit": "shāyad", "en": "maybe" }] },
            { "id": "ge-89-4", "type": "chooseTranslation", "direction": "toDari", "dari": "احتمالاً او رفته است", "translit": "ehtemālan ō rafta ast", "en": "He has probably gone.", "distractorsDari": [{ "dari": "حتماً او رفته است", "translit": "hatman ō rafta ast" }, { "dari": "او هرگز نرفته است", "translit": "ō hargez narafta ast" }] },
            { "id": "ge-89-5", "type": "spotError", "dari": "هرگز فردا می‌آید", "translit": "hargez fardā mēāyad", "en": "He'll probably come tomorrow.", "errorWord": { "dari": "هرگز", "translit": "hargez" }, "correction": { "dari": "احتمالاً", "translit": "ehtemālan" }, "hint": "'Probably' is ehtemālan; hargez means 'never'." },
            { "id": "ge-89-6", "type": "fillBlank", "dari": "به ___ من، کار سخت است", "translit": "ba ___ man, kār sakht ast", "en": "In my opinion, the work is hard.", "answer": { "dari": "گمان", "translit": "gumān" }, "distractors": [{ "dari": "دست", "translit": "dast" }, { "dari": "یاد", "translit": "yād" }] }
          ]
        },
        {
          "id": "gl-90",
          "title": "Layered concession",
          "subtitle": "Stacking counter-arguments",
          "grammarPoint": "layered-concession",
          "grammarPointEn": "Building a nuanced argument by stacking concession and result: agarche … amā … bā īn ham … (although … but … even so …).",
          "slides": [
            {
              "id": "gs-90-1",
              "title": "Grant, counter, conclude",
              "body": "A sophisticated argument concedes a point (agarche), counters it (amā), and still concludes (bā īn ham / bāz ham). Layering these shows control.",
              "examples": [
                { "dari": "اگرچه سخت بود، اما با این هم موفق شد", "translit": "agarche sakht būd, amā bā īn ham muwaffaq shud", "en": "Although it was hard, but even so he succeeded.", "highlight": "با این هم" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-90-1", "type": "chooseTranslation", "direction": "toEn", "dari": "اگرچه سخت بود، اما با این هم کرد", "translit": "agarche sakht būd, amā bā īn ham kard", "en": "Although it was hard, even so he did it.", "distractorsEn": ["Because it was hard, he did it.", "It was hard, so he didn't do it."] },
            { "id": "ge-90-2", "type": "fillBlank", "dari": "اگرچه مانده بود، اما ___ کار کرد", "translit": "agarche mānda būd, amā ___ kār kard", "en": "Although he was tired, even so he worked.", "answer": { "dari": "با این هم", "translit": "bā īn ham" }, "distractors": [{ "dari": "چون", "translit": "chun" }, { "dari": "وگرنه", "translit": "wa gar na" }] },
            { "id": "ge-90-3", "type": "buildSentence", "en": "Although he was sick, even so he came.", "words": [{ "dari": "اگرچه", "translit": "agarche" }, { "dari": "مریض بود", "translit": "marīz būd" }, { "dari": "با این هم", "translit": "bā īn ham" }, { "dari": "آمد", "translit": "āmad" }], "translit": "agarche marīz būd, bā īn ham āmad", "extraWords": [{ "dari": "چون", "translit": "chun" }] },
            { "id": "ge-90-4", "type": "matchPairs", "prompt": "Match the argument moves", "pairs": [{ "dari": "اگرچه", "translit": "agarche", "en": "although (concede)" }, { "dari": "اما", "translit": "amā", "en": "but (counter)" }, { "dari": "با این هم", "translit": "bā īn ham", "en": "even so (conclude)" }, { "dari": "بنابراین", "translit": "binābar'īn", "en": "therefore" }] },
            { "id": "ge-90-5", "type": "chooseTranslation", "direction": "toDari", "dari": "اگرچه پول نداشت، با این هم کتاب خرید", "translit": "agarche pūl nadāsht, bā īn ham ketāb kharīd", "en": "Although he had no money, even so he bought a book.", "distractorsDari": [{ "dari": "چون پول نداشت، کتاب نخرید", "translit": "chun pūl nadāsht, ketāb nakharīd" }, { "dari": "پول نداشت بنابراین کتاب نخرید", "translit": "pūl nadāsht binābar'īn ketāb nakharīd" }] },
            { "id": "ge-90-6", "type": "spotError", "dari": "اگرچه سرد بود، بنابراین رفتیم", "translit": "agarche sard būd, binābar'īn raftēm", "en": "Although it was cold, even so we went.", "errorWord": { "dari": "بنابراین", "translit": "binābar'īn" }, "correction": { "dari": "با این هم", "translit": "bā īn ham" }, "hint": "After 'although', the answer is 'even so', not 'therefore'." }
          ]
        }
      ]
    },
    {
      "id": "gb-30",
      "title": "Near-Native",
      "subtitle": "The finishing touches",
      "lessons": [
        {
          "id": "gl-91",
          "title": "Precise time reference",
          "subtitle": "hanōz, tā ba hāl, dēgar",
          "grammarPoint": "precise-time",
          "grammarPointEn": "Fine time reference: hanōz (still / not yet), tā ba hāl (until now, with the perfect), and dēgar in the sense of 'no longer'.",
          "slides": [
            {
              "id": "gs-91-1",
              "title": "Still, yet, no longer",
              "body": "hanōz + negative = 'not yet'; tā ba hāl + perfect = 'until now'; dēgar + negative = 'no longer'. Small words, precise meanings.",
              "examples": [
                { "dari": "او هنوز نیامده است", "translit": "ō hanōz nayāmada ast", "en": "He hasn't come yet.", "highlight": "هنوز" },
                { "dari": "دیگر آنجا نمی‌روم", "translit": "dēgar ānjā namērawam", "en": "I no longer go there.", "highlight": "دیگر" }
              ]
            }
          ],
          "exercises": [
            { "id": "ge-91-1", "type": "fillBlank", "dari": "او ___ نیامده است", "translit": "ō ___ nayāmada ast", "en": "He hasn't come yet.", "answer": { "dari": "هنوز", "translit": "hanōz" }, "distractors": [{ "dari": "دیگر", "translit": "dēgar" }, { "dari": "همیشه", "translit": "hamēsha" }] },
            { "id": "ge-91-2", "type": "chooseTranslation", "direction": "toEn", "dari": "دیگر آنجا نمی‌روم", "translit": "dēgar ānjā namērawam", "en": "I no longer go there.", "distractorsEn": ["I still go there.", "I never went there."] },
            { "id": "ge-91-3", "type": "chooseTranslation", "direction": "toEn", "dari": "تا به حال او را ندیده‌ام", "translit": "tā ba hāl ō rā nadīda-am", "en": "Until now I haven't seen him.", "distractorsEn": ["I saw him just now.", "I will see him soon."] },
            { "id": "ge-91-4", "type": "spotError", "dari": "او دیگر نیامده است", "translit": "ō dēgar nayāmada ast", "en": "He hasn't come yet.", "errorWord": { "dari": "دیگر", "translit": "dēgar" }, "correction": { "dari": "هنوز", "translit": "hanōz" }, "hint": "'Not yet' is hanōz; dēgar means 'no longer'." },
            { "id": "ge-91-5", "type": "buildSentence", "en": "I still don't understand.", "words": [{ "dari": "هنوز", "translit": "hanōz" }, { "dari": "نمی‌فهمم", "translit": "namēfahmam" }], "translit": "hanōz namēfahmam", "extraWords": [{ "dari": "دیگر", "translit": "dēgar" }] },
            { "id": "ge-91-6", "type": "matchPairs", "prompt": "Match the time words", "pairs": [{ "dari": "هنوز", "translit": "hanōz", "en": "still / not yet" }, { "dari": "دیگر", "translit": "dēgar", "en": "no longer" }, { "dari": "تا به حال", "translit": "tā ba hāl", "en": "until now" }, { "dari": "همیشه", "translit": "hamēsha", "en": "always" }] }
          ]
        },
        {
          "id": "gl-92",
