{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "prs",
        "ca"
      ]
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^gh-\\d{2,3}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "level": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "C1",
              "C2"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "sample": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "translit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "target"
            ],
            "additionalProperties": false
          },
          "aliases": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "keywords": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocks": {
            "minItems": 2,
            "maxItems": 12,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "heading": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "rule"
                    },
                    "body": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "body"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "heading": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "pattern"
                    },
                    "parts": {
                      "minItems": 2,
                      "maxItems": 6,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "slot",
                              "fixed"
                            ]
                          }
                        },
                        "required": [
                          "text",
                          "kind"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "type",
                    "parts"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "heading": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "table"
                    },
                    "columns": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "rows": {
                      "minItems": 2,
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "string",
                            "minLength": 1
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "rows"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "heading": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "examples"
                    },
                    "items": {
                      "minItems": 1,
                      "maxItems": 5,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "target": {
                            "type": "string",
                            "minLength": 1
                          },
                          "translit": {
                            "type": "string",
                            "minLength": 1
                          },
                          "en": {
                            "type": "string",
                            "minLength": 1
                          },
                          "highlight": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "target",
                          "en"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "type",
                    "items"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "heading": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "mistake"
                    },
                    "wrong": {
                      "type": "object",
                      "properties": {
                        "target": {
                          "type": "string",
                          "minLength": 1
                        },
                        "translit": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "target"
                      ],
                      "additionalProperties": false
                    },
                    "right": {
                      "type": "object",
                      "properties": {
                        "target": {
                          "type": "string",
                          "minLength": 1
                        },
                        "translit": {
                          "type": "string",
                          "minLength": 1
                        },
                        "en": {
                          "type": "string",
                          "minLength": 1
                        },
                        "highlight": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "target",
                        "en"
                      ],
                      "additionalProperties": false
                    },
                    "why": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "wrong",
                    "right",
                    "why"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "heading": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "spoken"
                    },
                    "written": {
                      "type": "object",
                      "properties": {
                        "target": {
                          "type": "string",
                          "minLength": 1
                        },
                        "translit": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "target"
                      ],
                      "additionalProperties": false
                    },
                    "spoken": {
                      "type": "object",
                      "properties": {
                        "target": {
                          "type": "string",
                          "minLength": 1
                        },
                        "translit": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "target"
                      ],
                      "additionalProperties": false
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "written",
                    "spoken",
                    "note"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "related": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lessonIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^gl-\\d{2}$"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "level",
          "rank",
          "title",
          "summary",
          "sample",
          "aliases",
          "keywords",
          "blocks",
          "related",
          "lessonIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "language",
    "entries"
  ],
  "additionalProperties": false
}
