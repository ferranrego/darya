{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "const": "prs"
    },
    "units": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^au-\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string",
            "minLength": 1
          },
          "letters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "char": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "translit": {
                  "type": "string",
                  "minLength": 1
                },
                "sound": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string"
                },
                "forms": {
                  "type": "object",
                  "properties": {
                    "isolated": {
                      "type": "string",
                      "minLength": 1
                    },
                    "initial": {
                      "type": "string",
                      "minLength": 1
                    },
                    "medial": {
                      "type": "string",
                      "minLength": 1
                    },
                    "final": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "isolated",
                    "initial",
                    "medial",
                    "final"
                  ],
                  "additionalProperties": false
                },
                "nonConnecting": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "char",
                "name",
                "translit",
                "sound",
                "forms",
                "nonConnecting"
              ],
              "additionalProperties": false
            }
          },
          "exercises": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hint": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "recognizeLetter"
                    },
                    "targetChar": {
                      "type": "string"
                    },
                    "distractors": {
                      "minItems": 3,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "targetChar",
                    "distractors"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hint": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "pickForm"
                    },
                    "targetChar": {
                      "type": "string"
                    },
                    "word": {
                      "type": "string",
                      "minLength": 1
                    },
                    "translit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "glossEn": {
                      "type": "string"
                    },
                    "targetIndex": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "targetChar",
                    "word",
                    "translit",
                    "glossEn",
                    "targetIndex"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hint": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "matchSound"
                    },
                    "sound": {
                      "type": "string"
                    },
                    "targetChar": {
                      "type": "string"
                    },
                    "distractors": {
                      "minItems": 3,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "sound",
                    "targetChar",
                    "distractors"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hint": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "readWord"
                    },
                    "word": {
                      "type": "string",
                      "minLength": 1
                    },
                    "translit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "glossEn": {
                      "type": "string"
                    },
                    "choices": {
                      "minItems": 2,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "word",
                    "translit",
                    "glossEn",
                    "choices"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hint": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "readSentence"
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "translit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "target",
                    "translit",
                    "en"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hint": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "recognizeForm"
                    },
                    "targetChar": {
                      "type": "string"
                    },
                    "targetForm": {
                      "type": "string",
                      "enum": [
                        "initial",
                        "medial",
                        "final",
                        "isolated"
                      ]
                    },
                    "glyph": {
                      "type": "string",
                      "minLength": 1
                    },
                    "distractors": {
                      "minItems": 3,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "targetChar",
                    "targetForm",
                    "glyph",
                    "distractors"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hint": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "constructWord"
                    },
                    "letters": {
                      "minItems": 2,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "targetWord": {
                      "type": "string"
                    },
                    "distractors": {
                      "minItems": 3,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "letters",
                    "targetWord",
                    "distractors"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "subtitle",
          "letters",
          "exercises"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "language",
    "units"
  ],
  "additionalProperties": false
}
