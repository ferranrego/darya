{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "formatVersion": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "pattern": "^L\\d$"
    },
    "titleTarget": {
      "type": "string",
      "minLength": 1
    },
    "titleTranslit": {
      "type": "string",
      "minLength": 1
    },
    "titleEn": {
      "type": "string",
      "minLength": 1
    },
    "sentences": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "translit": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          },
          "tokens": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "surface": {
                  "type": "string",
                  "minLength": 1
                },
                "lexemeId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "syntaxRole": {
                  "type": "string",
                  "enum": [
                    "subject",
                    "object",
                    "verb"
                  ]
                }
              },
              "required": [
                "surface",
                "lexemeId"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "target",
          "en",
          "tokens"
        ],
        "additionalProperties": false
      }
    },
    "vocabUsed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "newWords": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "newWordRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "seed",
        "generated"
      ]
    },
    "model": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "grammarPoints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionEn": {
            "type": "string",
            "minLength": 1
          },
          "questionTarget": {
            "type": "string",
            "minLength": 1
          },
          "questionTranslit": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "translit": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "en",
                "target"
              ],
              "additionalProperties": false
            }
          },
          "answerIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "evidenceSentence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "type": "string",
            "enum": [
              "authored",
              "derived"
            ]
          }
        },
        "required": [
          "questionEn",
          "questionTarget",
          "options",
          "answerIndex",
          "evidenceSentence",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "formatVersion",
    "level",
    "titleTarget",
    "titleEn",
    "sentences",
    "vocabUsed",
    "newWords",
    "newWordRatio",
    "source",
    "createdAt",
    "grammarPoints",
    "questions"
  ],
  "additionalProperties": false
}
