        { "char": "ه", "name": "he", "translit": "h / -a", "sound": "h as in hello; silent '-a' at word ends", "forms": { "isolated": "ه", "initial": "هـ", "medial": "ـهـ", "final": "ـه" }, "nonConnecting": false },
