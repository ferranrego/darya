    {
      "id": "au-01",
      "title": "First strokes",
      "subtitle": "Learn آ، ا، ب، ن — and read your first words: water and bread.",
      "letters": [
        { "char": "آ", "name": "alef maddā", "translit": "ā", "sound": "long 'a' as in father", "forms": { "isolated": "آ", "initial": "آ", "medial": "ـآ", "final": "ـآ" }, "nonConnecting": true },
        { "char": "ا", "name": "alef", "translit": "ā / –", "sound": "long 'a', or a vowel seat at the start of words", "forms": { "isolated": "ا", "initial": "ا", "medial": "ـا", "final": "ـا" }, "nonConnecting": true },
        { "char": "ب", "name": "be", "translit": "b", "sound": "b as in bread", "forms": { "isolated": "ب", "initial": "بـ", "medial": "ـبـ", "final": "ـب" }, "nonConnecting": false },
        { "char": "ن", "name": "nūn", "translit": "n", "sound": "n as in nan", "forms": { "isolated": "ن", "initial": "نـ", "medial": "ـنـ", "final": "ـن" }, "nonConnecting": false }
      ],
      "exercises": [
        { "id": "au01-e1", "type": "recognizeLetter", "targetChar": "آ", "distractors": ["ا", "ب", "ن"], "hint": "The little wave on top makes it 'ā'." },
        { "id": "au01-e2", "type": "recognizeLetter", "targetChar": "ب", "distractors": ["ن", "ا", "آ"], "hint": "One dot below the boat." },
        { "id": "au01-e3", "type": "recognizeLetter", "targetChar": "ن", "distractors": ["ب", "ا", "آ"], "hint": "One dot above the bowl." },
        { "id": "au01-e4", "type": "matchSound", "sound": "long 'ā' as in father", "targetChar": "آ", "distractors": ["ب", "ن"] },
        { "id": "au01-e5", "type": "pickForm", "targetChar": "ب", "word": "بابا", "translit": "bābā", "glossEn": "dad", "targetIndex": 0, "hint": "Find the first 'b' — it joins to the next letter." },
        { "id": "au01-e6", "type": "pickForm", "targetChar": "ن", "word": "نان", "translit": "nān", "glossEn": "bread", "targetIndex": 2, "hint": "The 'n' at the end keeps its bowl." },
        { "id": "au01-e7", "type": "readWord", "word": "آب", "translit": "āb", "glossEn": "water", "choices": ["āb", "bā", "nān"] },
        { "id": "au01-e8", "type": "readWord", "word": "نان", "translit": "nān", "glossEn": "bread", "choices": ["nān", "nun", "bān"] },
        { "id": "au01-e9", "type": "readWord", "word": "بابا", "translit": "bābā", "glossEn": "dad", "choices": ["bābā", "bāb", "ābā"] }
      ]
    },
    {
