        { "id": "au03-e6", "type": "pickForm", "targetChar": "ه", "word": "میوه", "translit": "mēwa", "glossEn": "fruit", "targetIndex": 3, "hint": "At the end it sounds like '-a'." },
        { "id": "au03-e7", "type": "pickForm", "targetChar": "ی", "word": "آبی", "translit": "ābī", "glossEn": "blue", "targetIndex": 2 },
        { "id": "au03-e8", "type": "readWord", "word": "تو", "translit": "tu", "glossEn": "you", "choices": ["tu", "tō", "ut"] },
        { "id": "au03-e9", "type": "readWord", "word": "او", "translit": "ō", "glossEn": "he, she", "choices": ["ō", "wā", "ū"] },
        { "id": "au03-e10", "type": "readWord", "word": "هوا", "translit": "hawā", "glossEn": "weather; air", "choices": ["hawā", "hāwa", "wāh"] },
        { "id": "au03-e11", "type": "readWord", "word": "میوه", "translit": "mēwa", "glossEn": "fruit", "choices": ["mēwa", "mawē", "yawa"] }
