# Which language this build teaches: `prs` (Darya) or `ca` (Riera). Selects the
# LanguageProfile and, via scripts/link-content.ts, the content/active symlink.
# Defaults to `prs` when unset - so an unset value is a silent Dari build.
NEXT_PUBLIC_TARGET_LANG=

# One Supabase project per language. Never point two languages at one project:
# the schema has no language column, by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Absolute origin of this deployment, used to build links in push payloads.
NEXT_PUBLIC_APP_URL=

# The provider chain, in the order src/lib/ai/providers.ts tries them:
# huggingface -> groq -> openrouter -> groq-fallback -> huggingface-fallback.
# Every quota here is FREE TIER and SHARED BY EVERY USER OF THE DEPLOYMENT.
# The *_MODEL vars are optional; each provider has a default, but a default that
# names a model the account cannot reach fails silently (the chain recovers and
# the request just costs two wasted calls). Verify a new one with a real call.
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
HUGGINGFACE_MODEL_FALLBACK=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MODEL_FALLBACK=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Web push. Generate a pair per deployment with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Authenticates the Vercel cron reminder route. Unset means reminders are
# accepted from anyone - or, if the route checks and finds nothing, delivered to
# no one; both have happened.
CRON_SECRET=

# Shared secret for the chat_messages insert webhook. Must match the value in
# the database setting app.settings.chat_push_secret (see the chat push migration).
CHAT_PUSH_SECRET=

# Not deployment config, so deliberately not set here: NODE_ENV (framework), and
# the per-invocation knobs of the human-only audit tools - AUDIT_LEVEL,
# AUDIT_PER_LEVEL (scripts/audit-generation.live.test.ts) and AUTHOR_LEVEL,
# AUTHOR_COUNT, AUTHOR_FROM (scripts/author-brief.manual.test.ts). Pass those on
# the command line for the one run that needs them.
